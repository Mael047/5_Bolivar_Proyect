  m_Script: {fileID: 11500000, guid: 3ea7162138bedf24dbcbb990d2b454ad, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroSlideshow
  _slides:
  - image: {fileID: 21300000, guid: eb3354c771de87a40a11a38d03923fbc, type: 3}
    text: "\xA1Soy Chopi, un viajero del tiempo! :3. Corrijo anomal\xEDas temporales
      donde aparecen."
    duration: 0
  - image: {fileID: 21300000, guid: e69cadc0dd147b942aedaba4cea33e6b, type: 3}
    text: "\xA1Me encanta la historia! Vi una espada genial en un museo."
    duration: 0
  - image: {fileID: 21300000, guid: d49292180d59d9b46a92b059e107987e, type: 3}
    text: "\xA1Atraves\xE9 un portal a un lugar desconocido!"
    duration: 0
  - image: {fileID: 21300000, guid: 4ce9b9fb369a725439806d403b710564, type: 3}
    text: "Al salir, algo se sinti\xF3 diferente..."
    duration: 0
  - image: {fileID: 21300000, guid: 4a61148bec2893849b6a6860a708abf7, type: 3}
    text: "\xA1No encuentro mi reloj! Debo hallar la salida para volver a casa."
    duration: 0
  - image: {fileID: 21300000, guid: 06b6f5f8e8d446a4184c8e0070811e6d, type: 3}
    text: "Esto queda entre t\xFA y yo >:c"
    duration: 0
  _autoAdvance: 1
  _defaultDuration: 7
  _clickToAdvance: 1
  _allowSkip: 1
  _typeSpeed: 45
  _continueHint: Clic para continuar
